# Example settings for running WoPeD in a browser with `make -C images up`.
#
#   cp .myenv/local.example .myenv/local && chmod 600 .myenv/local
#
# Only .myenv/local.example is tracked by git; .myenv/local (your real values) is ignored.
# This file is sourced by a shell, so do not add `echo` lines that print secrets.
# (An existing .myenv/local may already hold other variables, for example a GitLab token.
#  Just add the lines below to it.)

# REQUIRED. The password the browser asks for at http://127.0.0.1:14500
export XPRA_PASSWORD='change-me'

# OPTIONAL. Host folder that is mounted at /nets inside the container, for saving nets.
# Default: <repo>/mynets (created if missing, git-ignored).
# A relative path is taken relative to the repo root; $HOME and ~ work as usual in a shell.
# export WOPED_NETS_DIR="$HOME/woped-nets"

# Everything else (port, image name, ...) is set on the command line, see: make -C images help
